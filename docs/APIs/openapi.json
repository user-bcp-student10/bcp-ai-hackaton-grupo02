  "info": {
    "title": "Wallet mock W0–W6",
    "version": "0.1.0",
    "description": "Mock público de la hackatón para 8 grupos fijos. Selecciona el servidor de tu grupo. Estado en memoria por grupo, sin persistencia; puede reiniciarse por inactividad o despliegue. PEN en céntimos. W0 acepta documentos ficticios TEST, DNI y CE; W1 continúa limitado a documentos TEST. CORS habilitado. Incluye registro e inicio de sesión W0."
  },
  "servers": [
    {
      "url": "https://bcp-wallet-mock.yefri.workers.dev/groups/2",
      "description": "Grupo 2"
    }
  ],
