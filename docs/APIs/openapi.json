    "/auth/signup": {
      "post": {
        "operationId": "signUp",
        "summary": "Registrar credenciales",
        "description": "Registra una cuenta de prueba. No inicia sesión ni crea una wallet; el onboarding se completa por separado mediante POST /kyc/verifications. No devuelve la contraseña.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "TEST"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^TEST-.+$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password",
                      "email"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "DNI"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^[0-9]{8}$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password",
                      "email"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "CE"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^[0-9]{9}$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password",
                      "email"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta registrada; no se inicia sesión ni se crea una wallet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account_id": {
                      "type": "string",
                      "example": "account-001"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "REGISTERED"
                      ]
                    }
                  },
                  "required": [
                    "account_id",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: falta un campo, un campo tiene tipo o formato incorrecto, el correo no es válido o document no respeta el formato del documentType (TEST con prefijo TEST-, DNI de 8 dígitos o CE de 9 dígitos)."
          },
          "409": {
            "description": "ACCOUNT_ALREADY_EXISTS: el documento o correo ya está asociado a otra cuenta."
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: el cuerpo de la petición excede el tamaño permitido."
          },
          "429": {
            "description": "RATE_LIMITED: se superó el límite de intentos de registro."
          },
          "503": {
            "description": "AUTH_UNAVAILABLE: el servicio de autenticación no está disponible."
          }
        },
        "tags": [
          "W0 · Registro e inicio de sesión"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Iniciar sesión",
        "description": "Autentica con el tipo y número de documento ficticio registrados y la contraseña. Se admiten TEST, DNI de 8 dígitos y CE de 9 dígitos. Las credenciales heredadas DNI/CE se verifican sin modificar sus filas. El login no consulta ni valida una wallet. No devuelve la contraseña.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "TEST"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^TEST-.+$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "DNI"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^[0-9]{8}$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "documentType": {
                        "type": "string",
                        "enum": [
                          "CE"
                        ]
                      },
                      "document": {
                        "type": "string",
                        "pattern": "^[0-9]{9}$"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      }
                    },
                    "required": [
                      "documentType",
                      "document",
                      "password"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión correcto; devuelve el token y el identificador de cuenta sin consultar una wallet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "example": "<token>"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    },
                    "expires_in": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Duración del token en segundos.",
                      "example": 3600
                    },
                    "account_id": {
                      "type": "string",
                      "example": "account-001"
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "account_id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: falta un campo, un campo tiene tipo incorrecto o document no respeta el formato del documentType (TEST con prefijo TEST-, DNI de 8 dígitos o CE de 9 dígitos)."
          },
          "401": {
            "description": "INVALID_CREDENTIALS: el documento no existe o la contraseña es incorrecta; la respuesta no distingue cuál falló."
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: el cuerpo de la petición excede el tamaño permitido."
          },
          "429": {
            "description": "RATE_LIMITED: se superó el límite de intentos de inicio de sesión."
          },
          "503": {
            "description": "AUTH_UNAVAILABLE: el servicio de autenticación o la persistencia/emisión del token no está disponible."
          }
        },
        "tags": [
          "W0 · Registro e inicio de sesión"
        ]
      }
    },
